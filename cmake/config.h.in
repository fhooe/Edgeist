/**
 * @brief The projects namespace
 */
namespace @CMAKE_PROJECT_NAME@{
    /**
     * @brief The @PROJECT_NAME@ component namespace
     */
    namespace @PROJECT_NAME@{
    constexpr size_t VERSION_MAJOR = @PROJECT_VERSION_MAJOR@; ///< The projects major number
    constexpr size_t VERSION_MINOR = @PROJECT_VERSION_MINOR@; ///< The projects minor number
    constexpr size_t VERSION_PATCH = @PROJECT_VERSION_PATCH@; ///< The projects patch number
    constexpr size_t VERSION_TWEAK = @PROJECT_VERSION_TWEAK@; ///< The projects tweak number
    constexpr char const* const BUILD_TIMESTAMP = "@TODAY@"; ///< The projects build timestamp
    constexpr char const* const COMMIT_HASH = "@GIT_REVISION@"; ///< The projects git revision

    /**
     * @brief Enum which can be used to check the projects build type.
