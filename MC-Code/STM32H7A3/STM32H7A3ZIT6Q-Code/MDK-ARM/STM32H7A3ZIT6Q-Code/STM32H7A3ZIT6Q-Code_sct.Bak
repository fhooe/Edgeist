LR_IROM1 0x08000000 0x00200000  {    ; load region size_region
  Bank1     0x08000000 0x00100000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  ; Start of Bank2 (bin File)
  ; need to be in a flash sector alone
  MyBinFile 0x08100000 FIXED 0x00010000  {     ; place .bin file at 0x08040000
    Model.bin
  }
  Bank2     0x08110000 0x000F0000 {
    .ANY (+RO)
    .ANY (+XO)
  }
  RW_IRAM2 0x24000000 0x00100000  {  ; RW data
   .ANY (+RW +ZI)
  }
}

